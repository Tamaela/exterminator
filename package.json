{
  "name": "exterminator",
  "private": true,
  "description": "Chrome extension that disables other extensions on sensitive websites.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:chrome": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.js\"",
    "icons": "python3 tools/make-icons.py icons",
    "package": "sh tools/package.sh",
    "preview": "python3 -m http.server 8766 --bind 127.0.0.1"
  },
  "devDependencies": {
    "jsdom": "24.1.3",
    "puppeteer": "25.17.0"
  }
}
